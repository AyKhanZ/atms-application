limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=addr:10m;

# SignalR negotiate is a plain POST: send "Connection: upgrade" only when the client asked for it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;

    root /usr/share/nginx/html;

    # Attachments are up to 25 MB.
    client_max_body_size 26m;

    # 503 would look like "the server is down" in the app.
    limit_req_status 429;
    limit_conn_status 429;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # outputHashing puts a content hash in the filename, so these can stay cached for a year.
    # Quoted: an unquoted "{" in the regex is the start of a block.
    location ~* "-[A-Za-z0-9]{8,}\.[A-Za-z0-9]+$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ^~ keeps the hashed-file regex above away from API paths: image names are GUIDs,
    # and "<guid>.png" would otherwise be looked up as a static file and return 404.

    location ^~ /project/hubs/ {
        limit_req zone=api burst=50 nodelay;
        limit_conn addr 30;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://gateway:8080;
    }

    location ^~ /admin/ {
        limit_req zone=api burst=50 nodelay;
        limit_conn addr 30;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://gateway:8080;
    }

    location ^~ /project/ {
        limit_req zone=api burst=50 nodelay;
        limit_conn addr 30;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://gateway:8080;
    }

    location ^~ /app/images/ {
        limit_req zone=api burst=50 nodelay;
        limit_conn addr 30;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://gateway:8080;
    }
}
